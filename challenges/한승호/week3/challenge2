#include <stdio.h>

int main(){
        int f_sum=0, w_sum=0, do_sum = 0;
        int i;

        for(i = 0; i<=10; i++){
                f_sum+=i;
        }
        printf("for문 : %d\n ", f_sum);

        i = 1;
        while (i <= 10) {
        w_sum += i;
        i++;
        }
        printf("while문 : %d\n", w_sum);

        i = 1;
        do {
        do_sum += i;
        i++;
        } while (i <= 10);
        printf("do-while문 : %d\n", do_sum);
}

for문: 1부터 10까지 더하는 것처럼 반복 횟수가 명확하게 정해져 있을 때 가장 가독성이 좋다

while문: 횟수보다는 '사용자가 0을 누를 때까지'처럼 특정 조건이 참인 동안 계속 반복해야 할 때 주로 사용

do-while문: 조건의 참/거짓 여부와 상관없이 무조건 코드를 최소 1회는 먼저 실행하고 나서 반복할지 결정해야 할 때(예: 게임의 첫 메뉴판 출력) 사용
