
#include <stdio.h>

int main(void) {
    int num = 10;
    int *ptr = &num;


    printf("num의 값: %d\n", num);
    printf("num의 주소: %p\n", (void*)&num);

    printf("\n[포인터 확인]\n");
    printf("ptr의 값(저장된 주소): %p\n", (void*)ptr);
    printf("*ptr의 값(가리키는 변수의 값): %d\n", *ptr);


    *ptr = 20;

    printf("\n[값 변경 후]\n");
    printf("num의 값: %d\n", num);
    printf("*ptr의 값: %d\n", *ptr);


    printf("\n[포인터 변수 정보]\n");
    printf("포인터 변수의 크기: %zu bytes\n", sizeof(ptr));
    printf("포인터 변수의 주소: %p\n", (void*)&ptr);
    return 0
      }
포인터 변수의 크기는 8바이트이며 일반적인 64-bit 시스템에서는 메모리 주소를 64비트로 표현하기 때문에 8비트 이다.
