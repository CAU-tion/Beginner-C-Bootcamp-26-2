
    printf("[Reference 함수 내부]\n");
    printf("*a = %d, *b = %d\n", *a, *b);
}

int main(void) {
    int x = 10;
    int y = 20;

    printf("=== Call by Value ===\n");
    printf("함수 호출 전: x = %d, y = %d\n", x, y);

    swap_by_value(x, y);

    printf("함수 호출 후: x = %d, y = %d\n", x, y);

    printf("\n=== Call by Reference ===\n");
    printf("함수 호출 전: x = %d, y = %d\n", x, y);

    swap_by_reference(&x, &y);

    printf("함수 호출 후: x = %d, y = %d\n", x, y);

    return 0;
}

Call by Value는 변수의 값이 복사되어 전달되므로 함수 내부에서 값을 변경해도 원본 변수에는 영향을 주지 않으며, 
  원본 값을 유지하면서 계산할 때 사용한다. 반면 Call by Reference는 포인터를 통해 변수의 주소를 전달하므로 원본 변수의 값을 직접 변경할 수 있으며, 
함수 내에서 원본 데이터를 수정하거나 여러 값을 반환해야 할 때 사용한다.
